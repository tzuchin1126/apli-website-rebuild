<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>apli_website_rebuild</RootNamespace>
  </PropertyGroup>

  <Target Name="CopySharedFooterToPublishDirectory" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Pages\Shared" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Pages\Shared\_Footer.cshtml"
          DestinationFiles="$(PublishDir)Pages\Shared\_Footer.cshtml" />
  </Target>

</Project>
