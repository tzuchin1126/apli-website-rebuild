<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 亞太國際物流</title>
    <link rel="stylesheet" href="~/css/base/reset.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/site-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/site-footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="site-header" aria-label="主要導覽">
            <div class="site-container site-header__inner">
                <a class="site-header__brand" asp-area="" asp-page="/Index">亞太國際物流</a>
                <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">
                    <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
                    <span class="sr-only">開啟選單</span>
                </button>
                <div id="main-navigation" class="site-header__nav">
                    <a asp-area="" asp-page="/Index">首頁</a>
                    <a asp-area="" asp-page="/Privacy">隱私權政策</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="site-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-container">
            <span>&copy; 2026 亞太國際物流股份有限公司</span>
            <a asp-area="" asp-page="/Privacy">隱私權政策</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
